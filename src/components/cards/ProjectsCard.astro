---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const { project } = Astro.props;

import Card from '../Card.astro';

const projects = await getCollection('projects')
projects.sort( (a, b) => a.data.order - b.data.order ).filter( project => project.data.featured === true );
---

<Card className="p-1!">
    <div id="project-info" class="font-serif m-4 text-lg" data-projects>
        { projects.map( (project, i) => (
            <article data-project hidden={i !== 0}>
                <h2 class="text-ink text-lg"><span class="tracking-widest">PROJECTS</span> - { project.data.title }</h2>
                <p class="text-muted-ink text-sm">{ project.data.description }</p>

                <div class="mt-16 mx-auto flex-col justify-center relative border-t border-l border-r border-border rounded-t-lg shadow-xl">
                    <svg xmlns="http://w3.org" viewBox="0 0 600 20" width="100%" height="100%" class="w-full h-auto" preserveAspectRatio="none">
                        <!-- Window Control Buttons and Title Bar Background -->
                        <path d="M 0 6 A 6 6 0 0 1 6 0 L 594 0 A 6 6 0 0 1 600 6 L 600 45 L 0 45 Z" fill="#FFFFFF"/>
  
                        <!-- Window Control Buttons (Red, Yellow, Green) -->
                        <circle cx="15" cy="10.5" r="4" fill="#ef4444"/>
                        <circle cx="27" cy="10.5" r="4" fill="#f59e0b"/>
                        <circle cx="40" cy="10.5" r="4" fill="#10b981"/>
                    </svg>

                        {project.data.showcase && (<Image src={project.data.showcase} alt={'${project.data.title} showcase image.'}/>)}
                </div>
            </article>
        )) }
    </div>

    <script>
        const projectBlock = document.querySelectorAll<HTMLElement>("[data-project]");
        let showing = 0;
        setInterval( () => {
            projectBlock[showing].hidden = true;
            showing = (showing + 1) % projectBlock.length;
            projectBlock[showing].hidden = false;
        }, 7000);
    </script>
</Card>