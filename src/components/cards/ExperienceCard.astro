---
import Card from '../Card.astro';
---

<Card>
    <div id="experience-wrapper" class="m-4 font-serif">
        <div id="experience-heading">
            <h2 class="font-serif text-ink text-lg tracking-widest">BACKGROUND</h2>
            <p class="font-sans text-sm text-muted-ink">Where I studied & a few stops I've made along the way.</p>
        </div>

        <div id="experience-items" class="border-t border-border pt-6 mt-12">
            <ul>
                <li class="flex justify-between text-lg">
                    Aug. 2021 - May 2026
                    <h3 class="justify-self-end text-right">Cal State Univeristy, Dominguez Hills
                        <span class="block text-sm text-muted-ink">B.S. Computer Science</span>
                    </h3>
                </li>

                <li class="flex justify-between text-lg border-t border-border pt-6 mt-6">
                    Apr. 2026 - Present
                    <h3 class="justify-self-end text-right">Greystar<span class="block text-sm text-muted-ink">Leasing Professional</span></h3>
                </li>

                <li class="flex justify-between text-lg border-t border-border pt-6 mt-6">
                    Nov. 2024 - Apr. 2026
                    <h3 class="justify-self-end text-right">Greystar<span class="block text-sm text-muted-ink">Resident Svcs. Coordinator</span></h3>
                </li>
            </ul>
        </div>
    </div>
</Card>