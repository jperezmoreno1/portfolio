---
import { Image } from 'astro:assets';
import jose from '../../../public/jose.gif';
import Card from '../Card.astro';
---

<Card className="aspect-square p-0! overflow-hidden max-w-[350px]">
    <Image src={jose} alt="Jose Moreno smiling on the field following a Yankees-Angels baseball game."
    class="w-full h-full object-cover! [image-rendering:pixelated]"/>
</Card>